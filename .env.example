# =============================================================================
# Variables de entorno de IKI. Copiá este archivo a `.env` y completalo.
# `.env` está en .gitignore: NUNCA se commitea. Acá no va ningún valor real.
#
# Clasificación:
#   [PÚBLICA]  puede verse en el navegador o en el repo sin riesgo.
#   [PRIVADA]  no es una credencial, pero no conviene publicarla.
#   [SECRETA]  credencial. Solo en el .env local o en el panel del hosting.
#              Si se filtra: rotarla de inmediato.
# =============================================================================

# --- Django -------------------------------------------------------------------
# Settings a usar. manage.py usa dev por defecto; wsgi/asgi usan prod.
# DJANGO_SETTINGS_MODULE=config.settings.dev

# [PÚBLICA] Solo dev. En prod tiene que ser False (si no, el arranque falla).
DEBUG=True

# [SECRETA] Obligatoria en prod (50+ caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# [PÚBLICA] Hosts separados por coma. Obligatorias en prod.
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://iki.com.ar,https://www.iki.com.ar

# [PRIVADA] Ruta del admin (nunca "admin/"). Termina en "/". Obligatoria en prod.
ADMIN_URL=gestion-iki/

# --- Base de datos (Supabase Postgres) ----------------------------------------
# [SECRETA] Connection string del proyecto Supabase de DEV (la de prod, solo en el hosting).
# Supabase → Connect → Session pooler (puerto 5432). Vacía = SQLite local.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:5432/postgres
DATABASE_URL=

# [PÚBLICA] Segundos que se reutiliza una conexión.
DB_CONN_MAX_AGE=60
# [PÚBLICA] True solo si usás el pooler en modo transaction (puerto 6543).
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- Media (imágenes subidas) -------------------------------------------------
# [PÚBLICA] "local" (disco, default) o "supabase" (Supabase Storage vía S3).
MEDIA_STORAGE=local

# [PÚBLICA] URL del proyecto, ej: https://<project-ref>.supabase.co
SUPABASE_URL=
# [PÚBLICA] Bucket público de solo lectura para imágenes.
SUPABASE_STORAGE_BUCKET=iki-public
# [PÚBLICA] Región del proyecto (Storage → S3 Connection), ej: sa-east-1
SUPABASE_STORAGE_REGION=
# [SECRETA] Claves S3 de Storage (Storage → S3 Connection → Access keys).
# Tienen acceso total al Storage: solo en el servidor.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Email y formulario de contacto -------------------------------------------
# [SECRETA] Servidor de correo. Vacía = los mails se muestran en la consola (no se envían).
# Gmail: activar la verificación en 2 pasos y crear una "contraseña de aplicación".
#   EMAIL_URL=smtp+tls://cuenta%40gmail.com:CONTRASEÑADEAPLICACION@smtp.gmail.com:587
#   (la @ del usuario se escribe %40)
EMAIL_URL=
# [PÚBLICA] Remitente. Con Gmail tiene que ser la misma cuenta de EMAIL_URL.
DEFAULT_FROM_EMAIL=IKI <cuenta@gmail.com>
# [PRIVADA] Casilla que recibe los avisos de consultas nuevas.
CONTACT_NOTIFY_EMAIL=
# [PÚBLICA] Envíos del formulario permitidos por IP y por hora.
CONTACT_RATE_LIMIT=5

# --- HTTPS en producción --------------------------------------------------------
# [PÚBLICA] True solo si el hosting está detrás de un proxy que setea X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False
# [PÚBLICA] HSTS. Enviar el dominio a hstspreload.org es un paso manual y aparte.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
